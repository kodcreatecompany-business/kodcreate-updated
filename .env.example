# Provisioned automatically when the Neon integration is connected.
DATABASE_URL=

# Connect Resend email in v0 to provision this credential.
RESEND_API_KEY=

# Configure these in project Settings > Vars. Use plain email addresses.
# The sender must use a domain verified with your email provider.
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=kodcreatecompany@gmail.com

# Optional: set the canonical public URL after connecting your custom domain.
# Otherwise the app uses the Vercel production deployment hostname.
NEXT_PUBLIC_SITE_URL=
